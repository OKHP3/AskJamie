# =====================================================================
# AskJamie™ — .gitignore
# Comprehensive ignore patterns aligned with 2025/2026 best practices.
# Mirrors the cruft patterns enforced by scripts/audit-site.py
# (CRUFT_PATTERNS) so anything caught there is also kept out of git.
# =====================================================================

# ---------- Editor / IDE ----------
.vscode/
.idea/
*.sublime-workspace
*.sublime-project
.cursor/

# ---------- Operating-system junk ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---------- Editor backup / swap files ----------
*.bak
*.orig
*.swp
*.swo
*~
.*.sw?

# ---------- Python (scripts/ directory) ----------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.python-version

# ---------- Node (in case any tooling is added later) ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
.pnpm-store/

# ---------- Build / cache ----------
.cache/
dist/
build/
.parcel-cache/

# ---------- Local Replit state (already managed by platform) ----------
.local/
.upm/
.replit.local
attached_assets/

# ---------- Generated / regenerable artifacts ----------
# audit-report.md is regenerated by every `python3 scripts/audit-site.py` run
assets/docs/audit-report.md

# ---------- Secrets (defence in depth — there shouldn't be any) ----------
.env
.env.local
.env.*.local
*.key
*.pem
*.p12
secrets.json

# ---------- Misc ----------
*.log
.tmp/
.scratch/
assets/audit/responsive-qa/results.json

# ---------- Alternate spellings / additional baseline entries ----------
attached-assets/
_unused/
unused/
test-results/
playwright-report/
coverage/
.next/
.vite/
